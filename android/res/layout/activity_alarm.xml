<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/alarm_bg"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingTop="48dp"
            android:paddingRight="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.22"
                android:text="EXAM BUDDY"
                android:textColor="#fda4af"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alarm_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-light"
                android:text="08:00"
                android:textColor="#fff5f8"
                android:textSize="64sp" />

            <TextView
                android:id="@+id/alarm_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Time to study"
                android:textColor="#fff5f8"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alarm_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Your planned study block is starting now."
                android:textColor="#fecdd3"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/alarm_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/alarm_countdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Stops automatically in 60 seconds"
                    android:textColor="#fda4af"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="Sound plays through your Bluetooth device when one is connected, otherwise through the phone speaker."
                    android:textColor="#d4a6b4"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/alarm_stop"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/alarm_primary"
                    android:stateListAnimator="@null"
                    android:text="Turn off alarm"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/alarm_snooze"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/alarm_secondary"
                    android:stateListAnimator="@null"
                    android:text="Snooze 5 min"
                    android:textAllCaps="false"
                    android:textColor="#ffe4e6"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/alarm_open_app"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@android:color/transparent"
                    android:stateListAnimator="@null"
                    android:text="Open Exam Buddy"
                    android:textAllCaps="false"
                    android:textColor="#fda4af"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/alarm_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Press Back to snooze"
                    android:textColor="#a57684"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
